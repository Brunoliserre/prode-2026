datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  hasPaid         Boolean          @default(false)
  wantsToJoin     Boolean          @default(false)
  predictions     Prediction[]
  tournamentPicks TournamentPick[]
  dreamTeams      DreamTeam[]
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Fixture {
  id          String       @id @default(cuid())
  homeTeam    String
  awayTeam    String
  matchDate   DateTime
  matchday    Int?
  group       String?
  stage       String?      // GROUP_STAGE | LAST_32 | LAST_16 | QUARTER_FINALS | SEMI_FINALS | THIRD_PLACE | FINAL
  homeScore   Int?
  awayScore   Int?
  predictions Prediction[]
}

model Prediction {
  id        String  @id @default(cuid())
  userId    String
  fixtureId String
  homeScore Int
  awayScore Int
  points    Int     @default(0)
  user      User    @relation(fields: [userId], references: [id])
  fixture   Fixture @relation(fields: [fixtureId], references: [id])

  @@unique([userId, fixtureId])
}

// CHAMPION | RUNNER_UP | MVP | PICHICHI | REVELATION | FAIR_PLAY | RUSTICO | DESASTROSO | DECEPCION
model TournamentPick {
  id       String @id @default(cuid())
  userId   String
  category String
  value    String // team name or player name
  points   Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// Dream team de eliminatorias: 1 por usuario por ronda (LAST_32, LAST_16, ...).
model DreamTeam {
  id        String          @id @default(cuid())
  userId    String
  round     String // LAST_32 | LAST_16 | QUARTER_FINALS | SEMI_FINALS | THIRD_PLACE | FINAL
  formation String // "3-1-2", etc.
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  picks     DreamTeamPick[]

  @@unique([userId, round])
}

model DreamTeamPick {
  id          String    @id @default(cuid())
  dreamTeamId String
  slot        String // "GK0", "DEF0", "MED1", "FWD2", ...
  playerId    String // "<Team>-<apiFootballId>"
  dreamTeam   DreamTeam @relation(fields: [dreamTeamId], references: [id], onDelete: Cascade)

  @@unique([dreamTeamId, slot])
}

// Rating de FotMob (1-10) de un jugador en una ronda. Lo carga el admin a mano.
model PlayerScore {
  id       String @id @default(cuid())
  round    String
  playerId String // "<Team>-<apiFootballId>"
  rating   Float

  @@unique([round, playerId])
}
